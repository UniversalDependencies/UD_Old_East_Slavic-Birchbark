# newdoc id = texts/birchbark/798
# date_created = 1160-1180
# transl_ru = Поклон от Завида к … ({возможно,} к тетке). Тому из твоих сыновей, у которого есть зерно, прикажи, чтобы отдали дань Марене, поскольку я приду и ты тогда отдашь ({очевидно,} своему сыну) ({букв.:} отдай) назад зерном же. Кланяюсь тебе.
# transl_en_1 = Greetings from Zavid to ... (possibly, to aunt). Of your sons who has the grain, order them to hand over the tribute to Marena, since I will come and then you will return (apparently, to your son) the [loan] with grain. Goodbye.
# transl_en_2 = 
# page_id = 798
# sent_id = 798-1
# sent_transl_ru = Поклон от Завида к … ({возможно,} к тетке).
