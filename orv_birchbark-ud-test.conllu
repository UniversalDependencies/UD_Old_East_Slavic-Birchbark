# newdoc id = texts/birchbark/St_R_39
# date_created = 1380-1400
# transl_ru = Поклон от Григория Ермоле и Озекею. Я послал тебе шесть бочек вина, [уровень] — как палец достанет. Так что ты это хорошенько проверь. А продай как и те, на тех же условиях. А если ты то продал — так ты то отошли. А моим ребятам денег не давай — пошли вместе с долгом.
# transl_en_1 = 
# transl_en_2 = A bow from G[ri]gor’ja to Jermola and Ozekej. I have sent to you (singular) six barrels of wine, (filled) to a finger’s length (from the top). And you check it carefully, and sell them like those others, under the same conditions. And if you have sold them, send away the proceeds. And don’t give my servants (?) the money; send it along with the debt.
# page_id = Ст. Р. 39
# sent_id = St_R_39-1
