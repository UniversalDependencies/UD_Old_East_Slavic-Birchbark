# newdoc id = texts/birchbark/366
# date_created = 1360-1380
# transl_ru = Вот расчелся Яков с Гюргием и с Харитоном по бессудной грамоте, которую Гюргий взял [в суде] по поводу вытоптанной при езде пшеницы, а Харитон по поводу своих убытков. Взял Гюргий за все то рубль и три гривны и коробью пшеницы, а Харитон взял десять локтей сукна и гривну. А больше нет дела Гюргию и Харитону до Якова, ни Якову до Гюргия и Харитона. А на то свидетели Давыд, Лукин сын, и Степан Тайшин.
# transl_en_1 = 
# transl_en_2 = 
