# newdoc id = texts/birchbark/536
# date_created = 1380-1400
# transl_ru = Поклон от … к попу. [Я (?)] послал [тебе столько-то] денег (от деньга — мелкая монета) да пять … {Далее либо стояли слова со значением купи мне, либо просто продолжалось перечисление присланного. Дальнейший текст:} … [сукна] татарского пол-локтя, а [такого-то] две трети [локтя]. Замочи и пристриги [это сукно], а образец я послал. И пошли [мне] с теми же людьми. Да пошли сапожных гвоздей (?) на деньгу. А я тебе кланяюсь.
# transl_en_1 = 
# transl_en_2 = 
